TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/@LIBDIR@
STATLIB = $(LIBDIR)/libconnectivity.a
PKG_LIBS = -L$(LIBDIR) -lconnectivity

all: $(SHLIB) wrappers rust_clean

.PHONY: $(STATLIB) wrappers

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/vendor


# RUSTFLAGS appends --print=native-static-libs to ensure that 
# the correct linkers are used. Use this for debugging if need. 
#
# CRAN note: Cargo and Rustc versions are reported during
# configure via tools/msrv.R.
#
# rust/vendor.tar.xz is unpacked for offline compilation only when tools/config.R
# found it made from the current Cargo.lock. Leftovers of a failed build are
# removed first, so they cannot point cargo at stale crates.
$(STATLIB):

	rm -Rf $(CARGOTMP) $(VENDOR_DIR)
	if [ "@VENDOR@" = "yes" ]; then \
		echo "=== Using offline vendor tarball ==="; \
		tar xf rust/vendor.tar.xz && \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml; \
	fi

	export CARGO_HOME=$(CARGOTMP) && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	@PANIC_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build --locked @CRAN_FLAGS@ --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) @TARGET@

	# Always clean up CARGOTMP
	rm -Rf $(CARGOTMP);

# Regenerate R/extendr-wrappers.R from the built library only during roxygen runs
# (devtools::document(), rextendr::document()), which set ROXYGEN_PKG.
wrappers: $(SHLIB)
	if [ -n "$$ROXYGEN_PKG" ]; then \
		"$(R_HOME)/bin/Rscript" ../tools/document.R $(R_PACKAGE_NAME) $(SHLIB) ../R/extendr-wrappers.R; \
	fi

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) $(VENDOR_DIR) @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(VENDOR_DIR)
